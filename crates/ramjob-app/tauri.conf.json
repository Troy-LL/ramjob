{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RamJob",
  "version": "0.1.0",
  "identifier": "app.ramjob.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RamJob",
        "width": 420,
        "height": 600,
        "decorations": false,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
